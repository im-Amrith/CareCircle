# CareCircle simulator orchestrator settings. Copy to .env (git-ignored) or set in your shell.

# CareCircle MCP server (Streamable HTTP)
MCP_URL=http://127.0.0.1:8000/mcp

# 1 = no AWS calls: keyword router instead of Bedrock, browser speech instead of Polly.
# 0 = use Bedrock and Polly. Unset = mock only when no AWS credentials are found.
# MOCK_AWS=1

# Amazon Bedrock (credentials come from the default AWS chain, e.g. `aws configure`; never put keys here)
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
AWS_REGION=ap-southeast-2

# Amazon Polly neural voices to try in order; falls back to browser speech if none work
POLLY_VOICES=Kajal,Joanna

# Orchestrator HTTP port
PORT=8100
